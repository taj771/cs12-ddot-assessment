  <dashboards>
    <dashboard enable-sort-zone-taborder='true' name='FY26 permit approvals'>
      <layout-options>
        <title>
          <formatted-text>
            <run>How long does DDOT take to approve new construction permits? (FY26)
</run>
          </formatted-text>
        </title>
      </layout-options>
      <style />
      <size maxheight='2200' maxwidth='1200' minheight='2200' minwidth='1200' preset-index='17' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='85545' id='16' param='horz' type-v2='layout-flow' w='98666' x='667' y='364'>
            <zone h='85545' id='5' param='vert' type-v2='layout-flow' w='98666' x='667' y='364'>
              <zone h='1909' id='7' type-v2='title' w='98666' x='667' y='364'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='3228' id='19' type-v2='text' w='98666' x='667' y='2273'>
                <formatted-text>
                  <run fontcolor='#000000' fontsize='11'>New construction permits issued in FY26 (1 Oct 2025 - 30 Sep 2026).</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='11'>Days to approve = business days from application to final approval. Weekends and DC public holidays are not counted; approved on the same day = 0.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='11'>The averages use permits applied for in July - September 2026, the only months where DDOT&apos;s permit layer is still complete (see &quot;About the data&quot; below).</run>
                  <run>Æ&#10;</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='6046' id='8' name='Overall' w='98666' x='667' y='5501'>
                <layout-cache fixed-size-h='125' type-h='fixed' type-w='fixed' />
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='3455' id='20' type-v2='text' w='98666' x='667' y='11547'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='14'>What makes approvals slower</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='11'>Applications sent back for changes, permits covering many locations, and paving, overhead or electric work take 3 to 5 times longer. Most permits are routine gas and water excavations, approved in 1 to 6 days. Each bar shows how many permits it is based on; small groups (under about 30) are less reliable.</run>
                  <run>Æ&#10;</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='11182' id='9' name='By work type' w='98666' x='667' y='15002'>
                <layout-cache fixed-size-h='238' minwidth='396' type-h='fixed' type-w='scalable' />
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='7546' id='10' name='Resubmission' w='98666' x='667' y='26184'>
                <layout-cache fixed-size-h='158' minwidth='180' type-h='fixed' type-w='scalable' />
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='9364' id='11' name='By number of locations' w='98666' x='667' y='33730'>
                <layout-cache fixed-size-h='198' minwidth='180' type-h='fixed' type-w='scalable' />
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='11182' id='12' name='By applicant' w='98666' x='667' y='43094'>
                <layout-cache fixed-size-h='238' minwidth='200' type-h='fixed' type-w='scalable' />
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone fixed-size='262' h='12273' id='13' is-fixed='true' name='Excavation by utility' w='98666' x='667' y='54276'>
                <layout-cache minwidth='220' type-h='fixed' type-w='scalable' />
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone fixed-size='119' forceUpdate='true' h='5773' id='21' is-fixed='true' type-v2='text' w='98666' x='667' y='66549'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='15'>About the data</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='11'>DDOT&apos;s construction permit layer (layer 23) removes permits once they expire, so most permits applied for early in the year are gone. Comparing it with DC&apos;s yearly permit layers, which keep every permit, shows it is complete only from July 2026. That is why the averages above use July - September 2026.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='11'>The yearly layers have no approval date, so for the whole year we can only show days from application to issue (bottom chart). It falls toward September because a late application only counts if it was issued before 30 September, so slow permits from those months are not yet included. It is not a trend.</run>
                  <run>Æ&#10;</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='10496' id='14' name='Data completeness' w='98666' x='667' y='72322'>
                <layout-cache minheight='184' type-h='scalable' type-w='cell' />
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone fixed-size='60' h='3091' id='17' is-fixed='true' leg-item-layout='vert' name='Data completeness' pane-specification-id='2' param='[federated.151o6ny0rdm6og11kal511t4yyzc].[:Measure Names]' type-v2='color' w='98666' x='667' y='82818'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
          </zone>
          <zone h='10318' id='18' name='Full year: days to issue' w='98666' x='667' y='85909'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='3409' id='22' type-v2='text' w='98666' x='667' y='96227'>
            <formatted-text>
              <run fontcolor='#000000'>Data: DC Open Data, DDOT construction permits (DDOT_TOPS layer 23) and yearly construction permit layers 2025 and 2026, pulled 15 October 2026. Business days skip weekends and DC public holidays (US federal holidays plus DC Emancipation Day). Prepared with Python (scripts/prepare_data.py).</run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
